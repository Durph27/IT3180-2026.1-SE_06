# Backend reads this file after copying it to .env at the repository root.
# Use Java properties syntax: no quotes; escape literal backslashes as \\.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bluemoon_db
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: creates the first admin only when app_user is empty. At least 12 chars.
# Leave blank to avoid creating an account. Never commit the actual password.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
# Optional Unicode TTF path; Windows Arial / Linux DejaVuSans are auto-detected.
PDF_FONT_PATH=
