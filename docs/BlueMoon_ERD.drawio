        <mxCell id="note" value="&lt;b&gt;ERD vật lý Sprint 1&lt;/b&gt;&lt;br/&gt;Nguồn: Flyway V1–V3. JSON snapshot lưu TEXT; FK ghi tên cột. Quan hệ qua trang tham chiếu tên bảng.&lt;br/&gt;app_role.code: ADMIN, MANAGER, AUTHORITY, ACCOUNTANT, RESIDENT." parent="1" vertex="1" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#f8fafc;strokeColor=#64748b;">
          <mxGeometry x="20" y="10" width="1440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="building" value="&lt;b&gt;building&lt;/b&gt;&lt;hr/&gt;id UUID PRIMARY KEY&lt;br/&gt;code VARCHAR(20) NOT NULL UNIQUE&lt;br/&gt;name VARCHAR(120) NOT NULL&lt;br/&gt;address TEXT NOT NULL" parent="1" vertex="1" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#f8fafc;strokeColor=#64748b;">
          <mxGeometry x="20" y="140" width="460" height="540" as="geometry" />
        </mxCell>
        <mxCell id="apartment" value="&lt;b&gt;apartment&lt;/b&gt;&lt;hr/&gt;id UUID PRIMARY KEY&lt;br/&gt;building_id UUID NOT NULL&lt;br/&gt;code VARCHAR(20) NOT NULL&lt;br/&gt;floor_no INTEGER NOT NULL&lt;br/&gt;area_m2 NUMERIC(10,2) NOT NULL CHECK (area_m2 &amp;gt;= 0)&lt;br/&gt;status VARCHAR(20) NOT NULL CHECK (status IN (&amp;#x27;VACANT&amp;#x27;,&amp;#x27;OCCUPIED&amp;#x27;,&amp;#x27;INACTIVE&amp;#x27;))&lt;br/&gt;UNIQUE(building_id, code)&lt;br/&gt;CHECK(area_m2 &amp;gt; 0)&lt;br/&gt;FK building_id → building.id" parent="1" vertex="1" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#f8fafc;strokeColor=#64748b;">
          <mxGeometry x="530" y="140" width="460" height="540" as="geometry" />
        </mxCell>
