        <mxCell id="resident" value="&lt;b&gt;resident&lt;/b&gt;&lt;hr/&gt;id UUID PRIMARY KEY&lt;br/&gt;full_name VARCHAR(120) NOT NULL&lt;br/&gt;identity_no VARCHAR(30) UNIQUE&lt;br/&gt;birth_date DATE NOT NULL&lt;br/&gt;gender VARCHAR(20) NOT NULL CHECK (gender IN (&amp;#x27;MALE&amp;#x27;,&amp;#x27;FEMALE&amp;#x27;,&amp;#x27;OTHER&amp;#x27;,&amp;#x27;UNSPECIFIED&amp;#x27;))&lt;br/&gt;phone VARCHAR(20)" parent="1" vertex="1" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#f8fafc;strokeColor=#64748b;">
