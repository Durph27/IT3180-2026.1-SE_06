        <mxCell id="maintenance_fund" value="&lt;b&gt;maintenance_fund&lt;/b&gt;&lt;hr/&gt;id UUID PRIMARY KEY&lt;br/&gt;code VARCHAR(30) NOT NULL UNIQUE&lt;br/&gt;name VARCHAR(120) NOT NULL&lt;br/&gt;opening_balance NUMERIC(18,2) NOT NULL CHECK(opening_balance &amp;gt;= 0)&lt;br/&gt;opening_date DATE NOT NULL&lt;br/&gt;created_at TIMESTAMP WITH TIME ZONE NOT NULL&lt;br/&gt;created_by UUID NOT NULL REFERENCES app_user(id)&lt;br/&gt;FK created_by → app_user.id" parent="1" vertex="1" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#f8fafc;strokeColor=#64748b;">
          <mxGeometry x="20" y="140" width="460" height="540" as="geometry" />
